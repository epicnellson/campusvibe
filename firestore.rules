rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.is_admin == true;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isNotBanned() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.banned != true;
    }

    function isVerified() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.verification_status == "approved";
    }

    // ── profiles ──────────────────────────────────────
    match /profiles/{userId} {
      // Anyone authenticated can read profiles
      allow read: if isAuthenticated();
      // Owner can create their own profile (doc ID must == auth UID)
      allow create: if isOwner(userId);
      // Owner can update own profile, but cannot change is_admin or banned
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['is_admin', 'banned', 'verification_status']);
      // Admin can update any profile (for verification, ban, etc.)
      allow update: if isAdmin();
      // Admin can delete profiles
      allow delete: if isAdmin();
    }

    // ── posts ─────────────────────────────────────────
    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isVerified() && request.resource.data.user_id == request.auth.uid;
      allow update: if isOwner(request.resource.data.user_id) || isAdmin();
      allow delete: if isOwner(resource.data.user_id) || isAdmin();
    }

    // ── confessions ───────────────────────────────────
    match /confessions/{confessionId} {
      allow read: if isAuthenticated();
      allow create: if isVerified() && request.resource.data.user_id == request.auth.uid;
      // Owner can update likes array, admin can delete
      allow update: if isVerified();
      allow delete: if isOwner(resource.data.user_id) || isAdmin();
    }

    // ── events ────────────────────────────────────────
    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow create: if isVerified() && request.resource.data.user_id == request.auth.uid;
      allow update: if isVerified(); // RSVPs require any verified user
      allow delete: if isOwner(resource.data.user_id) || isAdmin();
    }

    // ── listings ──────────────────────────────────────
    match /listings/{listingId} {
      allow read: if isAuthenticated();
      allow create: if isVerified() && request.resource.data.user_id == request.auth.uid;
      allow update: if isOwner(resource.data.user_id);
      allow delete: if isOwner(resource.data.user_id) || isAdmin();
    }

    // ── channels ──────────────────────────────────────
    match /channels/{channelId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // ── channel_members ───────────────────────────────
    match /channel_members/{membershipId} {
      allow read: if isAuthenticated();
      // Any authenticated user can join (for auto-join on signup + DM creation)
      allow create: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // ── messages ──────────────────────────────────────
    match /messages/{messageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.user_id == request.auth.uid;
      allow update: if isAuthenticated();
      // Owner can delete own messages
      allow delete: if isOwner(resource.data.user_id) || isAdmin();
    }

    // ── follows ───────────────────────────────────────
    match /follows/{followId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.follower_id == request.auth.uid;
      // Follower can unfollow (delete their own follow)
      allow delete: if isAuthenticated();
    }

    // ── reactions ─────────────────────────────────────
    match /reactions/{reactionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.user_id == request.auth.uid;
      allow delete: if isOwner(resource.data.user_id);
    }

    // ── reposts ───────────────────────────────────────
    match /reposts/{repostId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.user_id == request.auth.uid;
      allow delete: if isOwner(resource.data.user_id);
    }

    // ── comments ──────────────────────────────────────
    match /comments/{commentId} {
      allow read: if isAuthenticated();
      allow create: if isVerified()
        && request.resource.data.user_id == request.auth.uid;
      allow delete: if isOwner(resource.data.user_id) || isAdmin();
    }

    // ── reports ───────────────────────────────────────
    match /reports/{reportId} {
      allow read: if isAuthenticated();
      // Anyone authenticated can submit a report
      allow create: if isAuthenticated();
      // Admin can dismiss reports
      allow delete: if isAdmin();
      allow update: if isAdmin();
    }

    // ── push_tokens ───────────────────────────────────
    match /push_tokens/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }

    // ── in_app_notifications ──────────────────────────
    match /in_app_notifications/{notifId} {
      allow read: if isOwner(resource.data.user_id);
      allow create: if isAuthenticated();
      // Owner can mark as read; admin can delete
      allow update: if isOwner(resource.data.user_id);
      allow delete: if isOwner(resource.data.user_id) || isAdmin();
    }

    // ── admin_actions ─────────────────────────────────
    match /admin_actions/{actionId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
    }

    // ── blocked_users ─────────────────────────────────
    match /blocked_users/{blockId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.blocker_id == request.auth.uid;
      allow delete: if isAuthenticated();
    }

    // ── pinned_messages ────────────────────────────────
    match /pinned_messages/{pinId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // ── online_status ──────────────────────────────────
    match /online_status/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // ── typing ─────────────────────────────────────────
    match /typing/{channelId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
